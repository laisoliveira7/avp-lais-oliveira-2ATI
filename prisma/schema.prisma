generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int    @id @default(autoincrement())
  nome      String
  email     String @unique
  senhaHash String

  personagens Personagem[]

  @@map("usuarios")
}

model Personagem {
  id        Int     @id @default(autoincrement())
  nome      String
  casa      String
  especie   String
  ocupacao  String
  usuarioId Int?
  criador   Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("personagens")
}
